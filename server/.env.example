# ─────────────────────────────────────────────
# Server Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL="postgresql://cpd_user:cpd_secret@localhost:5432/cpd_db"

# Server port
PORT=4000

# Node environment
NODE_ENV=development

# CORS — allowed frontend origin
CLIENT_ORIGIN=http://localhost:5173

# JWT Secrets — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=replace_with_a_strong_32plus_char_secret
REFRESH_TOKEN_SECRET=replace_with_a_different_strong_secret

# Token lifetimes (ms format accepted by jsonwebtoken: 15m, 7d, etc.)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# bcrypt rounds (10-12 recommended; higher = slower hashing = more secure)
BCRYPT_ROUNDS=12
